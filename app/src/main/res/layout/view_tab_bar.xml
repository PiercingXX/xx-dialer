<?xml version="1.0" encoding="utf-8"?>
<!-- Shared tab shell (design §12): four equal items Recents · Keypad ·
     People · Rules. Active state = Signal-white label (selector
     @color/xx_tab_text on the selected state) + a hairline top indicator;
     inactive sits at white_50. Text-only by design — no ic_* drawable set
     covers all four tabs, and mixing would break the mono look.
     Indicators stay `invisible` (not gone) so row height never jumps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Top indicator strip: one hairline cell per item -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/tab_ind_recents"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_hairline"
            android:layout_weight="1"
            android:background="@color/pxx_signal"
            android:visibility="invisible"/>

        <View
            android:id="@+id/tab_ind_keypad"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_hairline"
            android:layout_weight="1"
            android:background="@color/pxx_signal"
            android:visibility="invisible"/>

        <View
            android:id="@+id/tab_ind_people"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_hairline"
            android:layout_weight="1"
            android:background="@color/pxx_signal"
            android:visibility="invisible"/>

        <View
            android:id="@+id/tab_ind_rules"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_hairline"
            android:layout_weight="1"
            android:background="@color/pxx_signal"
            android:visibility="invisible"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_recents"
            style="@style/Widget.Xx.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/tab_recents"/>

        <TextView
            android:id="@+id/tab_keypad"
            style="@style/Widget.Xx.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/tab_keypad"/>

        <TextView
            android:id="@+id/tab_people"
            style="@style/Widget.Xx.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/tab_people"/>

        <TextView
            android:id="@+id/tab_rules"
            style="@style/Widget.Xx.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/tab_rules"/>
    </LinearLayout>
</LinearLayout>
