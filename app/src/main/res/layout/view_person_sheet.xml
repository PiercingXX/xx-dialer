<?xml version="1.0" encoding="utf-8"?>
<!-- Contact sheet (§12.3): numbers, tier controls (star ↔ provider when
     writable, Business ↔ Room always), custom-ringtone note, call/history.
     Star writes may fail under Scopes — sheetError states it honestly.
     Row labels are set in code; no new string resources exist to reference. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/xx_gutter"
    android:paddingRight="@dimen/xx_gutter"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/sheetName"
        style="@style/TextAppearance.Xx.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/sheetNumber"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/sheetRingtoneNote"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sheetStarLabel"
            style="@style/TextAppearance.Xx.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pxx_signal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetStarSwitch"
            style="@style/Widget.Xx.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/sheetBizLabel"
            style="@style/TextAppearance.Xx.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pxx_signal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheetBizSwitch"
            style="@style/Widget.Xx.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheetGroups"
        style="@style/TextAppearance.Xx.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Add to group" />

    <TextView
        android:id="@+id/sheetError"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/pxx_error"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sheetCall"
            style="@style/Widget.Xx.ButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_button_height"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/call" />

        <Button
            android:id="@+id/sheetMessage"
            style="@style/Widget.Xx.ButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_button_height"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Message" />

        <Button
            android:id="@+id/sheetHistory"
            style="@style/Widget.Xx.ButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/xx_button_height"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/tab_recents" />
    </LinearLayout>

</LinearLayout>
