<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup flow (design §12 Setup): every step renders its ACTUAL state on resume —
  a half-configured dialer that looks configured is the failure this screen
  exists against (§4.1). AMOLED black, hairlines, mono everywhere (§12.1).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/xx_gutter"
            android:paddingRight="@dimen/xx_gutter"
            android:paddingTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup"
                android:textAppearance="@style/TextAppearance.Xx.Display"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="xx-dialer · each step shows its real state"
                android:textAppearance="@style/TextAppearance.Xx.Chip"/>

            <!-- Step 1 (§4.1): default-dialer role, held-state verified AFTER
                 the request — RESULT_OK alone is never trusted. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_dialer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default phone app"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:id="@+id/status_dialer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Restricted-Settings walk-through (§4.1): shown only after
                     the refusal signature is detected (OK result, role absent). -->
                <TextView
                    android:id="@+id/walkthrough_dialer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sideloaded apps are gated: open App Info → ⋮ → “Allow restricted settings”, then request the role again."
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>

                <Button
                    android:id="@+id/btn_app_info_dialer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open App Info"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>

                <Button
                    android:id="@+id/btn_dialer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Set as default phone app"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>
            </LinearLayout>

            <!-- Step 2 (§4.1): ROLE_CALL_SCREENING — vacant on stock
                 GrapheneOS; when another package holds it, name it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_screening"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caller ID &amp; spam app"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:id="@+id/status_screening"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/conflict_screening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>

                <TextView
                    android:id="@+id/walkthrough_screening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sideloaded apps are gated: open App Info → ⋮ → “Allow restricted settings”, then request the role again."
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>

                <Button
                    android:id="@+id/btn_app_info_screening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open App Info"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>

                <Button
                    android:id="@+id/btn_screening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Set as caller ID &amp; spam app"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>
            </LinearLayout>

            <!-- Step 3 (§10, §15): channels ensured here; reconcile warnings
                 are surfaced verbatim — the user's mute choice is respected. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_channels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ring channels"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:id="@+id/status_channels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/warnings_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Step 4 (§4.1 grant cascade + GrapheneOS Contact Scopes):
                 runtime READ_CONTACTS; partial grants are fine and expected. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_contacts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contacts"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:id="@+id/status_contacts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/note_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="On GrapheneOS, Contact Scopes may grant only some contacts — partial grants are expected; anything not scoped simply classifies as unknown."
                    android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>

                <Button
                    android:id="@+id/btn_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Allow contacts access"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>
            </LinearLayout>

            <!-- Step 5 (§15): full-screen intent — when false, calls still
                 ring as heads-up; we offer the grant screen, never nag. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_fsi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full-screen incoming call"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:id="@+id/status_fsi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_fsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Allow full-screen notifications"
                    android:visibility="gone"
                    style="@style/Widget.Xx.ButtonSecondary"/>
            </LinearLayout>

            <!-- Step 6 (§15 observe week): plain statement; silencing is
                 OFFERED after the log proves itself, never flipped silently.
                 The copy is shared with the Rules switch via strings.xml so
                 the promise made here is the one that screen keeps. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                style="@style/Widget.Xx.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/glyph_observe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:text="→"
                        android:textAppearance="@style/TextAppearance.Xx.Chip"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_watch_title"
                            android:textAppearance="@style/TextAppearance.Xx.Body"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/setup_watch_body"
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>

                        <TextView
                            android:id="@+id/date_observe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Xx.BodySmall"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/xx_hairline"
        android:background="@drawable/divider_hairline"/>

    <Button
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/xx_gutter"
        android:layout_marginRight="@dimen/xx_gutter"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Done — open recents"
        style="@style/Widget.Xx.ButtonPrimary"/>

</LinearLayout>
