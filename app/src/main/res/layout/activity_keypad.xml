<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad tab (design §12.2): center-tab grid, a true 3×4 with no fourth
     column — backspace lives at the right-hand end of the entry row, beside
     the digits it deletes (the Pixel placement). The old trailing column
     existed on the bottom row only, so centring the grid centred four
     columns' worth of width and pushed the three digit columns ~85px left of
     the screen centre; with the column gone the 3×4 block centres on itself.
     Space Mono digits on bg_keypad_digit keys at xx_key_size, T9 match
     overlay, call block. Key chrome is inline because only existing styles
     may be consumed.

     Vertical arrangement, top to bottom: entry row (fixed) · match band
     (the one weighted row, absorbs all slack) · grid · call · tab bar. Only
     the band flexes. Everything below it therefore sits at a fixed offset
     from the bottom of the screen and does not move when T9 matches appear
     or clear — see the band's own comment for why that matters. -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingLeft="@dimen/xx_gutter"
    android:paddingRight="@dimen/xx_gutter">

    <!-- Entry row: number field with backspace at its right-hand end. Three
         things are load-bearing here.
         (1) The leading Space is the same width as the backspace, so the
             digits still centre on the *screen* and not on the space left
             over beside the button — a weighted field with only a trailing
             button would sit half a key-width left of centre, which is the
             lopsidedness this row exists to remove.
         (2) The field is 0dp + weight, never wrap_content: a long number
             truncates inside its own slot instead of growing the row and
             shoving the backspace off the right edge. ellipsize="start"
             drops the head, so the digits just typed stay visible.
         (3) Long-press on the backspace still clears the whole entry
             (KeypadActivity wires both the tap and the long-press); the
             button also stays enabled on an empty entry so that clear is
             always reachable. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Space
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="1dp"/>

        <TextView
            android:id="@+id/keypad_entry"
            style="@style/TextAppearance.Xx.KeypadDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:minHeight="48dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="start"
            android:textIsSelectable="false"/>

        <ImageButton
            android:id="@+id/key_delete"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_keypad_delete"
            android:scaleType="center"
            android:background="@drawable/bg_keypad_digit"
            android:contentDescription="Delete last digit; long-press to clear"/>
    </LinearLayout>

    <!-- Match band: the single flexible row of this screen, and the reason
         everything below it holds still.

         This band replaces the bare weighted Space that used to sit here. It
         is 0dp + weight, so it always absorbs exactly the slack the fixed
         rows leave over — which pins the grid, the call button and the tab
         bar at `screen bottom minus their own natural heights`, whether the
         match list is showing, empty, or gone. That is a safety property,
         not a cosmetic one: keypad_call used to walk down the screen as T9
         matches appeared and snap back up when the entry cleared, which puts
         the call button under a thumb that was aiming at backspace.

         The band must stay in the tree at all times. Its weight is what
         reserves the slack, and LinearLayout ignores a `gone` child
         completely — weight included — so if the ScrollView itself held the
         weight, hiding it on zero matches would hand the slack to nobody and
         the whole pad would jump *upward* instead. The band is never hidden;
         only its contents are.

         Inside it the ScrollView stays wrap_content, which inside a
         fixed-height parent means "hug the content, clamped to the band":
         one match occupies one row's worth, and a long list stops at the
         band's floor and scrolls internally. Either way the band's own
         height never changes, so nothing below it moves by a pixel. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/keypad_match_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/keypad_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1 -->
        <FrameLayout
            android:id="@+id/key_1"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_2"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="2"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="ABC"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_3"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="DEF"/>
        </FrameLayout>

        <!-- Row 2 -->
        <FrameLayout
            android:id="@+id/key_4"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="4"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="GHI"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_5"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="5"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="JKL"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_6"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="6"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="MNO"/>
        </FrameLayout>

        <!-- Row 3 -->
        <FrameLayout
            android:id="@+id/key_7"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="7"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="PQRS"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_8"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="TUV"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_9"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="9"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="WXYZ"/>
        </FrameLayout>

        <!-- Row 4 -->
        <FrameLayout
            android:id="@+id/key_star"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="*"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_0"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="8dp"
                android:text="0"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"
                android:text="+"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_hash"
            android:layout_width="@dimen/xx_key_size"
            android:layout_height="@dimen/xx_key_size"
            android:layout_margin="6dp"
            android:background="@drawable/bg_keypad_digit"
            android:clickable="true"
            android:focusable="true">
            <TextView
                style="@style/TextAppearance.Xx.KeypadDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="#"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingBottom="5dp"
                android:fontFamily="@font/font_body"
                android:textSize="8sp"
                android:letterSpacing="0.18"
                android:textColor="@color/pxx_white_25"/>
        </FrameLayout>
        <!-- Row 4 ends the pad: no fourth column. Backspace is up in the
             entry row; see the comment there. -->
    </GridLayout>

    <Button
        android:id="@+id/keypad_call"
        style="@style/Widget.Xx.ButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="Call"/>

    <include android:id="@+id/tab_bar" layout="@layout/view_tab_bar"/>

</LinearLayout>
