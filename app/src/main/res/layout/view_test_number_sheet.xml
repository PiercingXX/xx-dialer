<?xml version="1.0" encoding="utf-8"?>
<!-- Test-a-number bottom sheet (§12.4, §16): type any number, run THE decide()
     a real call runs over real facts, print the verdict + rule reason exactly
     as it would land in the screening log. Labels set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/xx_gutter"
    android:paddingRight="@dimen/xx_gutter"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/testEyebrow"
        style="@style/TextAppearance.Xx.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/testInput"
        style="@style/TextAppearance.Xx.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:inputType="phone"
        android:maxLines="1" />

    <Button
        android:id="@+id/testGo"
        style="@style/Widget.Xx.ButtonSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:id="@+id/testResultBlock"
        style="@style/Widget.Xx.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/testVerdict"
            style="@style/TextAppearance.Xx.Duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/testReason"
            style="@style/TextAppearance.Xx.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/testLogLine"
            style="@style/TextAppearance.Xx.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/testModeLine"
            style="@style/TextAppearance.Xx.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/testError"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/pxx_error"
        android:visibility="gone" />

</LinearLayout>
