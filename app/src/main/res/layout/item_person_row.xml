<?xml version="1.0" encoding="utf-8"?>
<!-- One mirrored contact (§12.3): deterministic monogram avatar (photos may
     not exist under Scopes), name, number, star/biz badges on the right.
     Badge text is set in code — no new string resources here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/xx_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/xx_gutter"
    android:paddingRight="@dimen/xx_gutter"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_list_row">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textSize="12sp"
        android:fontFamily="@string/font_display"
        android:textColor="@color/pxx_white_80" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/TextAppearance.Xx.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/number"
            style="@style/TextAppearance.Xx.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/starBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_star_filled"
        app:tint="@color/pxx_signal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bizBadge"
        style="@style/TextAppearance.Xx.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:visibility="gone" />

</LinearLayout>
