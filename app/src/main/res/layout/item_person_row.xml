<?xml version="1.0" encoding="utf-8"?>
<!-- One mirrored contact (§12.3): deterministic monogram avatar (photos may
     not exist under Scopes), name, number, white Nerd tier marks on the right.
     Mark text is set in code — no new string resources here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/xx_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/xx_gutter"
    android:paddingRight="@dimen/xx_gutter"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_list_row">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textSize="12sp"
        android:fontFamily="@font/font_display"
        android:textColor="@color/pxx_white_80" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/TextAppearance.Xx.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/number"
            style="@style/TextAppearance.Xx.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tierMarks"
        style="@style/TextAppearance.Xx.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/pxx_signal"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
