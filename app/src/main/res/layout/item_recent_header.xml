<?xml version="1.0" encoding="utf-8"?>
<!-- Group header for consecutive same-number calls (§12.1): count +
     expand toggle. Tapping expands/collapses the run's children. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/header_arrow"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:textColor="@color/pxx_white_50"/>

    <TextView
        android:id="@+id/header_title"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/header_count"
        style="@style/TextAppearance.Xx.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/pxx_white_50"/>
</LinearLayout>
