<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chip, resting: hairline white_25 outline on transparent,
     2dp radius (mockup .chip). Use bg_chip_selected for the invert. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <stroke
        android:width="@dimen/xx_hairline"
        android:color="@color/pxx_white_25"/>
    <corners android:radius="2dp"/>
</shape>
