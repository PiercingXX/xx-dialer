<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A dialer without telephony is nothing; required is honest. -->
    <uses-feature android:name="android.hardware.telephony" android:required="true"/>

    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Ring-next-time stars the provider contact (§12 recovery affordance,
         People sheet star ↔ provider). Same contacts permission set the
         dialer role auto-grants (§4.1) — no extra prompt. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Screen-off-at-the-ear (telecom/ProximityGuard): PROXIMITY_SCREEN_OFF_
         WAKE_LOCK is a wake lock like any other as far as the permission model
         is concerned, even though its whole purpose is turning the display OFF
         and keeping the touchscreen from hearing a cheek. Normal protection
         level, granted at install, no prompt, no runtime request. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Opt-in VVM permission set (todo.md "Permissions", D1). The dialer is
         offline by default: no INTERNET use, no network sockets. Android has no
         conditional <uses-permission>, so INTERNET + ACCESS_NETWORK_STATE are
         declared here unconditionally — but the app never opens a socket until
         the user turns the Visual voicemail toggle ON, at which point the client
         talks to the carrier mailbox over IMAP. The runtime opt-in gate is
         enforced by verifyVvmInternetOnly (todo.md D1): the guard pins that no
         socket site exists outside the VVM feature (the VVM client package
         lands in V3). ADD_VOICEMAIL /
         READ_VOICEMAIL / WRITE_VOICEMAIL back VoicemailContract (D3);
         SEND_SMS is the ACTIVATE/DEACTIVATE/query channel. BIND_VISUAL_
         VOICEMAIL_SERVICE is NOT here — it belongs on the <service> tag, not
         uses-permission (todo.md "Permissions"). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ADD_VOICEMAIL"/>
    <uses-permission android:name="android.permission.READ_VOICEMAIL"/>
    <uses-permission android:name="android.permission.WRITE_VOICEMAIL"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- Family theme-sync. XX-Launcher defines and sendBroadcast()s with this
         signature permission; uses-permission is required to receive it. -->
    <uses-permission android:name="com.piercingxx.xxlauncher.permission.THEME_SYNC"/>

    <!-- TxxT reads the Business tier and window through TierExportProvider.
         Signature so only family apps signed with this key can see who is
         marked Business; install-order declare+uses like THEME_SYNC. -->
    <permission
        android:name="com.piercingxx.xxdialer.permission.TIER_SYNC"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.piercingxx.xxdialer.permission.TIER_SYNC"/>

    <application
        android:name=".XxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.XxDialer">

        <!-- The dialer role needs one activity serving all three forms:
             ACTION_DIAL bare, ACTION_DIAL tel:, ACTION_VIEW tel: (§4.1). -->
        <activity
            android:name=".ui.DialActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.RecentsActivity" android:exported="false"/>
        <activity android:name=".ui.KeypadActivity" android:exported="false"/>
        <activity android:name=".ui.PeopleActivity" android:exported="false"/>
        <activity android:name=".ui.RulesActivity" android:exported="false"/>
        <activity android:name=".ui.VoicemailActivity" android:exported="false"/>
        <!-- The two call surfaces live in their OWN task, not the dialer's.
             Both are always started with FLAG_ACTIVITY_NEW_TASK, and NEW_TASK
             with the default affinity does not mean "a new task" — it means
             "the task that already has this affinity", i.e. the dialer's own
             back stack. That puts the in-call screen on top of whatever the
             user last had open in the dialer, so finishing at the end of the
             call reveals Recents/Keypad instead of the app the call
             interrupted. With a distinct affinity the call surfaces are always
             a task of their own on top of everything, and finishing the last
             of them hands the foreground back to the task underneath —
             the browser, the launcher, the lockscreen, or the dialer itself
             when the call was placed from there. That IS the "back to the last
             screen" behaviour; nothing needs to be launched to produce it.

             Left in Recents deliberately (no excludeFromRecents): while a call
             is live the overview entry is a legitimate way back to it, and the
             task disappears by itself the moment its last activity finishes. -->
        <activity
            android:name=".ui.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.piercingxx.xxdialer.call"/>
        <activity
            android:name=".ui.InCallActivity"
            android:exported="false"
            android:taskAffinity="com.piercingxx.xxdialer.call"/>
        <activity android:name=".ui.SetupActivity" android:exported="false"/>

        <!-- Owns the ringer; no car-mode metadata, ever (§4.1 disqualifier).
             ForegroundServicePermission suppressed: the phoneCall FGS type's
             second requirement is satisfied by holding ROLE_DIALER at
             runtime, not by MANAGE_OWN_CALLS (which is for self-managed
             ConnectionServices this app never registers). -->
        <service
            android:name=".telecom.XxInCallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true"/>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true"/>
        </service>

        <service
            android:name=".telecom.XxCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService"/>
            </intent-filter>
        </service>

        <!-- Opt-in Visual Voicemail (todo.md "Permissions" / D1). The carrier
             binds here with BIND_VISUAL_VOICEMAIL_SERVICE (the permission lives
             on the service tag, not in uses-permission) so we can ACTIVATE /
             DEACTIVATE the mailbox and receive its SMS notifications. The
             service is offline by default: every callback finishes its task
             immediately until the VVM toggle is on (VvmGate, later tasks). -->
        <service
            android:name=".vvm.XxVisualVoicemailService"
            android:exported="true"
            android:permission="android.permission.BIND_VISUAL_VOICEMAIL_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.VisualVoicemailService"/>
            </intent-filter>
        </service>

        <!-- Telecom hands over missed-call notification duty so the reason
             string can ride along (R7). B3: this exported component carries
             ONLY Telecom's protected broadcast — sent solely by Telecom
             (uid system), so third-party apps cannot forge it, and no
             privileged action is reachable through it. The dialer-privileged
             Block write lives in the non-exported sibling receiver below. -->
        <receiver
            android:name=".ring.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION"/>
            </intent-filter>
        </receiver>

        <!-- Family theme sync (BRAND-GUIDE §3.3): xx-launcher broadcasts its
             active background preset, explicitly targeted at this package
             (Intent.setPackage — required for a manifest receiver on O+).
             Exported because the sender is another app; B3-safe: the payload
             is a theme name and a color, so the worst a forged broadcast can
             do is recolor the UI — no privileged action is reachable. -->
        <provider
            android:name=".data.TierExportProvider"
            android:authorities="com.piercingxx.xxdialer.tier"
            android:exported="true"
            android:permission="com.piercingxx.xxdialer.permission.TIER_SYNC"/>

        <receiver
            android:name=".theme.ThemeSyncReceiver"
            android:exported="true"
            android:permission="com.piercingxx.xxlauncher.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- B3: BlockedNumberContract writes are dialer-privileged; this
             receiver is deliberately NON-exported so only this app's own
             notification PendingIntents can trigger a block. -->
        <receiver
            android:name=".ring.BlockActionsReceiver"
            android:exported="false"/>

        <!-- L3: notification "Call back" taps land here and route through
             telecom.CallManager.place (placeCall(), never ACTION_CALL). -->
        <activity
            android:name=".ring.CallbackTrampolineActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"/>

        <!-- Expecting-a-call tile (D15); manual shade placement. icon+label
             are REQUIRED for the tile to appear in the QS picker at all. -->
        <service
            android:name=".ring.XxTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_expecting"
            android:label="@string/tile_expecting_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

    </application>

</manifest>
