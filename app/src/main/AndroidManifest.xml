<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A dialer without telephony is nothing; required is honest. -->
    <uses-feature android:name="android.hardware.telephony" android:required="true"/>

    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- deliberately NO android.permission.INTERNET (design §13, R8) -->

    <application
        android:name=".XxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.XxPhone">

        <!-- The dialer role needs one activity serving all three forms:
             ACTION_DIAL bare, ACTION_DIAL tel:, ACTION_VIEW tel: (§4.1). -->
        <activity
            android:name=".ui.DialActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.RecentsActivity" android:exported="false"/>
        <activity android:name=".ui.KeypadActivity" android:exported="false"/>
        <activity android:name=".ui.PeopleActivity" android:exported="false"/>
        <activity android:name=".ui.RulesActivity" android:exported="false"/>
        <activity android:name=".ui.IncomingCallActivity" android:exported="false"/>
        <activity android:name=".ui.InCallActivity" android:exported="false"/>
        <activity android:name=".ui.SetupActivity" android:exported="false"/>

        <!-- Owns the ringer; no car-mode metadata, ever (§4.1 disqualifier).
             ForegroundServicePermission suppressed: the phoneCall FGS type's
             second requirement is satisfied by holding ROLE_DIALER at
             runtime, not by MANAGE_OWN_CALLS (which is for self-managed
             ConnectionServices this app never registers). -->
        <service
            android:name=".telecom.XxInCallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.telecom.BIND_INCALL_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true"/>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true"/>
        </service>

        <service
            android:name=".telecom.XxCallScreeningService"
            android:exported="true"
            android:permission="android.telecom.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService"/>
            </intent-filter>
        </service>

        <!-- Telecom hands over missed-call notification duty so the reason
             string can ride along (R7). B3: this exported component carries
             ONLY Telecom's protected broadcast — sent solely by Telecom
             (uid system), so third-party apps cannot forge it, and no
             privileged action is reachable through it. The dialer-privileged
             Block write lives in the non-exported sibling receiver below. -->
        <receiver
            android:name=".ring.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION"/>
            </intent-filter>
        </receiver>

        <!-- B3: BlockedNumberContract writes are dialer-privileged; this
             receiver is deliberately NON-exported so only this app's own
             notification PendingIntents can trigger a block. -->
        <receiver
            android:name=".ring.BlockActionsReceiver"
            android:exported="false"/>

        <!-- L3: notification "Call back" taps land here and route through
             telecom.CallManager.place (placeCall(), never ACTION_CALL). -->
        <activity
            android:name=".ring.CallbackTrampolineActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"/>

        <!-- Expecting-a-call tile (D15); manual shade placement. -->
        <service
            android:name=".ring.XxTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

    </application>

</manifest>
