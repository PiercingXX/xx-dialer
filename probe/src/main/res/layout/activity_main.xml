<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XX-Probe · WS0 platform probe"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Throwaway diagnostic. Answers land in design.md §4 [VERIFY]. No INTERNET permission."
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1 · ROLES"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRequestDialer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Request ROLE_DIALER"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/btnRequestScreening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Request ROLE_CALL_SCREENING"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/btnAuditRoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Audit roles + device"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/tvRoleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFF8A80"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2 · CHANNEL RING"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ring_instructions"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPostRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Post CallStyle test ring now"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3 · CONTACT SCOPES / PHONELOOKUP"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/contact_instructions"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPhoneLookup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Run PhoneLookup probe"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/btnScopeRecheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Re-run after Contacts scope change"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4 · RESULTS EXPORT"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShareLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#141414"
            android:text="Share probe_log.txt (offline ACTION_SEND)"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LOG (probe_log.txt)"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_hint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#FFEEEEEE"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
